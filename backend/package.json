{
  "name": "darttournament-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node-pg-migrate -m ../database/migrations/schema up",
    "db:rollback": "node-pg-migrate -m ../database/migrations/schema down",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2"
  }
}
